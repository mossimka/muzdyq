{
  "name": "Muzdyq — glacier watch",
  "short_name": "Muzdyq",
  "description": "Open, account-free repeat photography of Ile Alatau glaciers and water bodies. Citizen observations, CC BY 4.0.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f3f7f5",
  "theme_color": "#0f766e",
  "lang": "en",
  "categories": ["education", "science", "travel", "environment"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "How to contribute a photo",
      "short_name": "Contribute",
      "url": "/contribute",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Open data & API",
      "short_name": "Data",
      "url": "/data",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
