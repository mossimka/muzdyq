# Muzdyq configuration example.
#
# Copy to .env for docker compose:
#   cp .env.example .env
#
# For the local (non-Docker) backend the app also reads backend/.env.
# Every backend setting is case-insensitive; see backend/app/config.py for the
# full list and defaults.

# ---- ports ---------------------------------------------------------------
# Public web port served by the frontend container.
PORT=8080
# Direct API port (debugging only; the PWA uses the same-origin /api proxy).
BACKEND_PORT=8000

# ---- database ------------------------------------------------------------
POSTGRES_DB=muzdyq
POSTGRES_USER=muzdyq
POSTGRES_PASSWORD=change-me-in-production

# ---- secrets — CHANGE THESE BEFORE ANY PUBLIC DEPLOYMENT ----------------
# Required to call /api/admin/* (moderation). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=dev-admin-token-change-me
# Salt for hashed IP/device identifiers. Rotating it breaks rate-limit and
# duplicate-abuse correlation but does not affect published photos.
IP_HASH_SALT=dev-salt-change-me

# ---- public URL ----------------------------------------------------------
# Optional absolute base URL used in exported metadata, e.g.
# https://muzdyq.example.org . Leave empty to use request-relative URLs.
PUBLIC_BASE_URL=

# ---- seeding -------------------------------------------------------------
# Demo photos are synthetic, clearly labelled "DEMO PHOTO" and safe to show in
# a local evaluation. Set to false for a real deployment with real photos.
SEED_DEMO=true

# ---- limits --------------------------------------------------------------
UPLOAD_LIMIT_PER_HOUR=40
UPLOAD_LIMIT_PER_MINUTE=6
LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API directly (the compose setup
# is same-origin, so this only matters for a separate frontend host).
CORS_ORIGINS=http://localhost:8080
